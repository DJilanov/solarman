# Copy only when .env does not already exist; keep the populated file private.
PUBLIC_URL=http://localhost:3000
LISTEN_HOST=127.0.0.1
PORT=3000

# Separate database and role on the same PostgreSQL instance as the EU projects.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=solarman
DB_USERNAME=solarman_app
DB_PASSWORD=
DB_SSL=false

# First startup creates an administrator and an isolated workspace.
DASHBOARD_ADMIN_EMAIL=owner@example.com
# Generate with node scripts/hash-password.mjs; preserve literal dollar signs.
DASHBOARD_ADMIN_PASSWORD_HASH=
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Back up this key separately; it decrypts linked provider credentials.
CREDENTIAL_ENCRYPTION_KEY=

# Smart login alone is insufficient: request SOLARMAN OpenAPI activation.
# Optional shared platform keys require an appropriate multi-user licence.
# Tenants may instead supply their own App ID and App Secret in Settings.
SOLARMAN_APP_ID=
SOLARMAN_APP_SECRET=
SOLARMAN_BASE_URL=https://globalapi.solarmanpv.com
CALLBACK_PUBLIC_URL=https://solar.example.com

# Optional provider link for the FIRST administrator's workspace only.
SOLARMAN_EMAIL=
# Quote to preserve special characters; hashed before authentication.
SOLARMAN_PASSWORD=
# Alternative: leave plaintext empty and supply its SHA256 hash.
SOLARMAN_PASSWORD_SHA256=
# Optional legacy controller serial; dashboard users select discovered devices.
SOLARMAN_DEVICE_SN=

# Keep false until provider access and actual firmware reads are verified.
WRITES_ENABLED=false
# Control-cycle interval. Native checks and a provider clock check precede writes.
POLL_SECONDS=900
# Single-request monitoring while automation is paused: ~105,120 calls/year.
TELEMETRY_POLL_SECONDS=300
# Full native policy audit during supervision; writes always require fresh native checks.
CONTROL_AUDIT_SECONDS=3600
# Local rolling 365-day cap per App ID; raise only for a licensed allowance.
# Includes routine, authentication, recovery and balance requests.
SOLARMAN_API_CALL_LIMIT=200000
# Routine requests cannot spend this capacity. Stop and readback can.
SOLARMAN_API_RECOVERY_RESERVE=2000
COMMAND_TIMEOUT_SECONDS=30
INVERTER_TIMEZONE=Europe/Sofia
# Daily windows, not an expiring watchdog. See docs/controller.md.
CHARGE_WINDOW_MINUTES=25

# Optional read-only administrator recovery receipt. See docs/backups.md.
BACKUP_STATUS_FILE=/var/lib/solarman-backup/public/status.json
# HTTPS/production requires a fresh root-owned guard from solarman-erasure.service.
# ERASURE_GUARD_FILE=/var/lib/solarman-backup/public/erasure-guard.json
