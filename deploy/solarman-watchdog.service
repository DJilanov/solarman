[Unit]
Description=Independent Solarman reachability and health checks
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=solarman-watchdog
Group=solarman-watchdog
ExecStart=/usr/bin/flock --nonblock --no-fork --conflict-exit-code 75 /var/lib/solarman-watchdog/run.lock @NODE@ /opt/solarman-watchdog/current/scripts/watchdog.mjs --under-lock run
TimeoutStartSec=40
TimeoutStopSec=20
KillMode=control-group
SuccessExitStatus=75
UMask=0077
StateDirectory=solarman-watchdog
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/solarman-watchdog
